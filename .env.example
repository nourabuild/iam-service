# ==============================================================================
# Required — the service refuses to start without these
# ==============================================================================

# HMAC-SHA256 access-token signing key, minimum 32 bytes. Refresh tokens are
# opaque random values stored as SHA-256 hashes. Generate with: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=replace-with-openssl-rand-hex-32-output-min-32-bytes

# PostgreSQL connection (must be reachable at startup; the service pings it)
BLUEPRINT_DB_DATABASE=noura_iam_service_db
BLUEPRINT_DB_PASSWORD=postgres
BLUEPRINT_DB_USERNAME=postgres
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_SCHEMA=public

# ==============================================================================
# Optional — sensible defaults for local development
# ==============================================================================

# HTTP port (default 10067)
PORT=10067

# TLS to Postgres: disable | require | verify-ca | verify-full (default disable;
# use require or stricter for any non-local database)
BLUEPRINT_DB_SSLMODE=disable

# Used as-is by `make migrate-up` etc.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noura_iam_service_db?sslmode=disable

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For headers are trusted
# when deriving client IPs (rate limiting, logs). Empty = trust no proxy.
TRUSTED_PROXIES=

# CORS. Empty origins = allow all (credentials are then forced off).
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Kafka event publishing. If the brokers are unreachable at startup the
# service runs in degraded mode (no events; readiness shows kafka=disabled).
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1

# Sentry error tracking (empty DSN disables reporting)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Password reset emails (Mailtrap). Without a token, reset emails fail
# (reported to Sentry); the forgot-password endpoint still responds normally.
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_TEMPLATE_UUID=76de4eda-254e-41ed-87f8-a2fe114b616b
MAILTRAP_SENDER_EMAIL=noreply@example.com
MAILTRAP_SENDER_NAME=IAM Service

# Frontend page the emailed reset link points to (environment-specific)
PASSWORD_RESET_URL=https://meets.noura.software/reset-password
